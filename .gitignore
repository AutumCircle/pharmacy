# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local pharmacy sync agent runtime files
/backend/local-agent/config.json
/backend/local-agent/*.db
/backend/local-agent/*.log
/backend/local-agent/build/
/backend/local-agent/dist/
/backend/v1/local_agent/config.json
/backend/v1/local_agent/agent_sync_state.json
/backend/v1/local_agent/*.tmp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
