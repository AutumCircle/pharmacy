# Copy to .env.local only for local development. Never commit real values.

# Next.js -> API Gateway (server-only)
API_V1_BASE_URL=https://example.execute-api.eu-central-1.amazonaws.com/prod
API_KEY=replace-with-server-only-api-key
ADMIN_API_BEARER_TOKEN=replace-with-admin-or-notifier-bearer-token

# Web administration (server-only)
ADMIN_USERNAME=replace-with-admin-username
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_SESSION_SECRET=replace-with-random-32-plus-character-secret
STAFF_USERNAME=pharmacy_staff
STAFF_PASSWORD=replace-with-strong-password
